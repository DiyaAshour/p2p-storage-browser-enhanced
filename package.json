{
  "name": "chunknet",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "description": "Chunknet is a wallet-based P2P cloud storage desktop app with encrypted chunks, peer discovery, and manifest sync.",
  "author": "Diya Ashour",
  "type": "module",
  "main": "electron/main.js",
  "license": "MIT",
  "scripts": {
    "ensure:cloud-defaults": "node scripts/ensure-cloud-defaults.cjs",
    "ensure:paypal-ipc": "node scripts/ensure-renderer-paypal-ipc.cjs",
    "ensure:hard-delete-audit": "node scripts/ensure-hard-delete-cleanup-audit.cjs",
    "ensure:hard-delete-entrypoint": "node scripts/ensure-hard-delete-entrypoint.cjs",
    "ensure:protection-retry-ipc": "node scripts/ensure-protection-retry-early-ipc.cjs",
    "audit:secrets": "node scripts/check-secrets.mjs",
    "security:scan": "node scripts/security-scan.cjs",
    "production:scan": "node scripts/production-scan.cjs",
    "verify:ipc": "node scripts/verify-ipc-contract.cjs",
    "verify:renderer": "node scripts/verify-electron-only-renderer.cjs",
    "verify:large-files": "node scripts/verify-large-file-safety.cjs",
    "verify:chunk-policy": "node scripts/verify-chunk-policy.cjs",
    "verify:manifest-auth": "node scripts/verify-manifest-auth-routes.cjs",
    "verify:storage-peer": "node scripts/verify-storage-peer-safety.cjs",
    "verify:bootstrap": "node scripts/verify-bootstrap-safety.cjs",
    "verify:wallet-payment": "node scripts/verify-wallet-payment-safety.cjs",
    "verify:encryption": "node scripts/verify-encryption-safety.cjs",
    "verify:release": "node scripts/verify-release-readiness.cjs",
    "verify:smoke-plan": "node scripts/verify-smoke-test-plan.cjs",
    "verify:enterprise": "node scripts/verify-enterprise-consistency.cjs",
    "prepare:final": "pnpm run ensure:cloud-defaults && pnpm run ensure:paypal-ipc && pnpm run ensure:hard-delete-audit && pnpm run ensure:hard-delete-entrypoint && pnpm run ensure:protection-retry-ipc && pnpm run audit:secrets && pnpm run security:scan && pnpm run production:scan && pnpm run verify:ipc && pnpm run verify:renderer && pnpm run verify:large-files && pnpm run verify:chunk-policy && pnpm run verify:manifest-auth && pnpm run verify:storage-peer && pnpm run verify:bootstrap && pnpm run verify:wallet-payment && pnpm run verify:encryption && pnpm run verify:release && pnpm run verify:smoke-plan && pnpm run verify:enterprise && node scripts/verify-runtime.cjs",
    "verify": "pnpm run ensure:cloud-defaults && pnpm run ensure:paypal-ipc && pnpm run ensure:hard-delete-audit && pnpm run ensure:hard-delete-entrypoint && pnpm run ensure:protection-retry-ipc && pnpm run audit:secrets && pnpm run security:scan && pnpm run production:scan && pnpm run verify:ipc && pnpm run verify:renderer && pnpm run verify:large-files && pnpm run verify:chunk-policy && pnpm run verify:manifest-auth && pnpm run verify:storage-peer && pnpm run verify:bootstrap && pnpm run verify:wallet-payment && pnpm run verify:encryption && pnpm run verify:release && pnpm run verify:smoke-plan && pnpm run verify:enterprise && node scripts/verify-runtime.cjs",
    "verify:company": "node scripts/verify-company-drive-live-contract.cjs",
    "health": "node scripts/full-health-check.cjs",
    "health:deep": "node scripts/full-health-check.cjs --deep",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "dev:fast": "vite --host 127.0.0.1 --port 3000",
    "dev:renderer": "vite --host 127.0.0.1 --port 3000",
    "electron:dev": "node scripts/electron-dev-cloud.cjs",
    "electron:dev:raw": "pnpm run ensure:cloud-defaults && pnpm run ensure:paypal-ipc && pnpm run ensure:hard-delete-audit && pnpm run ensure:hard-delete-entrypoint && pnpm run ensure:protection-retry-ipc && concurrently \"pnpm dev:renderer\" \"node scripts/launch-electron.cjs\"",
    "electron:dev:fast": "pnpm run electron:dev",
    "dev:electron": "pnpm run electron:dev",
    "dev:electron:fast": "pnpm run electron:dev:fast",
    "start": "pnpm run electron:dev",
    "start:fast": "pnpm run electron:dev:fast",
    "renderer:build": "pnpm run prepare:final && vite build",
    "build": "pnpm run package:win",
    "build:fast": "pnpm run renderer:build",
    "package:dir": "pnpm run renderer:build && node scripts/package-win.cjs --dir",
    "package:win": "pnpm run renderer:build && node scripts/package-win.cjs",
    "dist": "pnpm run package:win",
    "test": "vitest run",
    "format": "prettier --write .",
    "paypal:server": "node server/paypal-checkout.js",
    "sync:manifests": "node server/manifest-sync.js",
    "storage:peer": "node server/storage-peer.js",
    "repair:electron": "node node_modules/electron/install.js",
    "legacy:apply-download-streaming": "node scripts/apply-download-streaming-to-path.cjs && node scripts/fix-streaming-final-script-syntax.cjs && node scripts/patch-streaming-upload-download-final.cjs",
    "legacy:apply-seed-account": "node scripts/enable-seed-account.cjs",
    "legacy:apply-seed-session": "node scripts/patch-seed-session-cache.cjs && node scripts/patch-main-seed-session-read.cjs",
    "legacy:folder-actions": "node scripts/verify-runtime.cjs",
    "legacy:join-company": "node scripts/patch-live-join-company-drive.cjs"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@phc/format": "^1.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@walletconnect/core": "^2.21.0",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.21.0",
    "@walletconnect/types": "^2.21.0",
    "@walletconnect/utils": "^2.21.0",
    "abitype": "^1.1.0",
    "argon2": "^0.44.0",
    "base64-js": "^1.5.1",
    "bn.js": "^5.2.2",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "electron-store": "^8.2.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^9.9.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "viem": "^2.52.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.9",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
